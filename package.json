{
  "name": "@pi/agent-mesh",
  "version": "0.1.0",
  "description": "Multi-agent messaging and shared-state layer on top of the pi SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "node scripts/test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:demo": "node node_modules/typescript/bin/tsc -p demo/tsconfig.demo.json",
    "check:imports": "node scripts/check-imports.mjs",
    "demo": "node demo/src/server.ts",
    "demo:start": "bash scripts/start-demo.sh",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "pack": "node scripts/pack.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-durable": "1.3.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
